MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=ai_campus_recruit
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
GATEWAY_HOST_PORT=8080
FRONTEND_HOST_PORT=80
# Build-time only: rebuild frontend after changing this value.
VITE_DEMO_MODE=false
# Set SPRING_DATA_REDIS_PORT to REDIS_HOST_PORT for native local Java services.
AUTH_PERSISTENCE_ENABLED=true
USER_PERSISTENCE_ENABLED=true
DASHBOARD_REALTIME_ENABLED=true
AI_CORE_PERSISTENCE_ENABLED=true
# Seed sample accounts/content only when explicitly requested.
DEMO_SEED_ENABLED=false
# Required to provision the first administrator without demo accounts.
BOOTSTRAP_ADMIN_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=resumes
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ISSUER=ai-campus-recruit
JWT_TTL_SECONDS=86400
GATEWAY_AUTH_ENABLED=true
# Keep API docs public only for local development. Set false in production.
GATEWAY_PUBLIC_DOCS_ENABLED=false
# Comma-separated browser origins allowed to send credentialed requests.
GATEWAY_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
# Business services stay on the Docker network. Add a local compose override
# for temporary debugging rather than exposing them in the default stack.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MAX_TOKENS=8192
DASHSCOPE_TEMPERATURE=0.2
DASHSCOPE_CONNECT_TIMEOUT=10s
DASHSCOPE_READ_TIMEOUT=120s
DASHSCOPE_MAX_CONCURRENCY=8
DASHSCOPE_ACQUIRE_TIMEOUT=2s
DASHSCOPE_FAILURE_THRESHOLD=3
DASHSCOPE_CIRCUIT_OPEN_TIME=30s
RESUME_PERSISTENCE_ENABLED=true
JOB_PERSISTENCE_ENABLED=true
MATCH_PERSISTENCE_ENABLED=true
DELIVERY_PERSISTENCE_ENABLED=true
AI_SCREENING_PERSISTENCE_ENABLED=true
AI_PLANNING_PERSISTENCE_ENABLED=true
AI_KNOWLEDGE_PERSISTENCE_ENABLED=true
DELIVERY_EVENTS_ROCKETMQ_ENABLED=true
DELIVERY_EVENTS_TOPIC=delivery-events
# Optional jobId=companyId pairs for non-demo deployments.
DELIVERY_JOB_COMPANY_MAP=
