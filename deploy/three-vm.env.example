VM1_HOST=192.168.56.11
VM2_HOST=192.168.56.12
VM3_HOST=192.168.56.13

MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=ai_campus_recruit
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=resumes
AI_KNOWLEDGE_MINIO_BUCKET=knowledge
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ISSUER=ai-campus-recruit
JWT_TTL_SECONDS=86400
GATEWAY_AUTH_ENABLED=true
GATEWAY_PUBLIC_DOCS_ENABLED=false
# Match the actual VM1 browser origin; include the port when using a non-default port.
GATEWAY_ALLOWED_ORIGINS=http://192.168.56.11,http://localhost
# Build-time only; false keeps real API errors visible.
VITE_DEMO_MODE=false

DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEMPERATURE=0.2
DASHSCOPE_MAX_TOKENS=8192
DASHSCOPE_CONNECT_TIMEOUT=10s
DASHSCOPE_READ_TIMEOUT=120s
DASHSCOPE_MAX_CONCURRENCY=8
DASHSCOPE_ACQUIRE_TIMEOUT=2s
DASHSCOPE_FAILURE_THRESHOLD=3
DASHSCOPE_CIRCUIT_OPEN_TIME=30s

AI_SCREENING_PERSISTENCE_ENABLED=true
AI_PLANNING_PERSISTENCE_ENABLED=true
AI_KNOWLEDGE_PERSISTENCE_ENABLED=true
AI_KNOWLEDGE_SEED_ENABLED=true
AI_KNOWLEDGE_SEED_LOCATIONS=classpath*:/knowledge/*.json
AI_KNOWLEDGE_CORPUS_VERSION=v3.10-campus-rag-corpus
AI_KNOWLEDGE_INGESTION_MAX_FILE_BYTES=10485760
AI_KNOWLEDGE_INGESTION_MAX_FILE_SIZE=10MB
AI_KNOWLEDGE_INGESTION_MAX_REQUEST_SIZE=12MB
AI_KNOWLEDGE_INGESTION_MAX_TEXT_CHARS=120000
AI_KNOWLEDGE_INGESTION_MAX_JOBS=200
AI_KNOWLEDGE_OBJECT_STORAGE_ENABLED=true
AI_KNOWLEDGE_VECTOR_ENABLED=true
AI_KNOWLEDGE_VECTOR_PROVIDER=milvus-rest
MILVUS_ENDPOINT=http://milvus-standalone:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=campus_knowledge_chunks
MILVUS_DIMENSION=96
AI_SCREENING_CACHE_TTL=10m
AI_SCREENING_ROCKETMQ_ENABLED=true
AI_SCREENING_ROCKETMQ_CONSUMER_GROUP=ai-screening-consumer
RESUME_PERSISTENCE_ENABLED=true
RESUME_CACHE_TTL=10m
JOB_PERSISTENCE_ENABLED=true
JOB_CACHE_TTL=10m
MATCH_PERSISTENCE_ENABLED=true
MATCH_CACHE_TTL=10m
DELIVERY_PERSISTENCE_ENABLED=true
DELIVERY_CACHE_TTL=10m
DELIVERY_EVENTS_ROCKETMQ_ENABLED=true
DELIVERY_EVENTS_TOPIC=delivery-events
# Optional explicit jobId=companyId pairs; other jobs use the job service.
DELIVERY_JOB_COMPANY_MAP=
DASHBOARD_REALTIME_ENABLED=true

FRONTEND_PORT=80
GATEWAY_PORT=8080
NODE_EXPORTER_PORT=9100
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
SENTINEL_DASHBOARD_PORT=8858
SENTINEL_DASHBOARD_USER=sentinel
SENTINEL_DASHBOARD_PASSWORD=replace-with-a-strong-sentinel-password
